{
  "program": "grlite",
  "format": "grlite-scenario",
  "version": 1,
  "name": "gravitational lens (EM wave through a mass)",
  "grid": { "W": 384, "H": 384, "dx": 1.0, "cEff": 1.0, "cfl": 0.7071067811865476 },
  "global": {
    "gEff": 1.0, "kE": 1.0, "shape": "bump", "kernelRadius": 8, "forceInterp": "lewis-birdsall",
    "absorber": { "outerBC": "dirichlet", "frictionFloor": 0.0, "frictionWall": 0.02, "frictionDepth": 48, "zeroMeanScalar": false },
    "init": { "method": "zero", "settleSteps": 0 },
    "switches": {
      "gravitomagneticForce": false, "gravitomagneticInductive": false,
      "emLorentz": false, "emInductive": false, "emElectrostatic": false, "emMagnetic": false,
      "emStressEnergy": false, "emShapiro": true,
      "fieldEvolution": true, "particleSourceDeposition": true, "esirkepov": true, "periodicBC": false
    },
    "rhoSmooth": 0, "jSmooth": 0, "bgMode": "analytic", "selfFieldDefault": false, "noRadiation": false
  },
  "background": [
    { "x": 192.0, "y": 192.0, "GM": 0.8, "Q": 0.0, "Jz": 0.0, "gFactor": 2.0, "epsilon": 6.0 }
  ],
  "particles": [
    { "x": 70.0, "y": 196.0, "vx": 0.0, "vy": 0.0, "mass": 0.001, "charge": 1.0,  "forces": false, "drive": { "amp": 1.5, "omega": 0.19635, "phase": 0.0, "axis": [0, 1] } },
    { "x": 70.0, "y": 188.0, "vx": 0.0, "vy": 0.0, "mass": 0.001, "charge": -1.0, "forces": false, "drive": { "amp": 1.5, "omega": 0.19635, "phase": 3.14159, "axis": [0, 1] } }
  ],
  "view": { "field": 6, "showTrails": false, "showVelocity": false, "source": "perturbation", "vectorField": 0, "vectorSpacing": 12, "tickInterval": 0,
    "forceArrows": { "grav": false, "em": false, "spin": false, "total": false } }
}
