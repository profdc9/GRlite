{
  "program": "grlite",
  "format": "grlite-scenario",
  "version": 1,
  "name": "relativistic orbit (perihelion precession)",
  "description": "A test mass on an eccentric orbit around a Schwarzschild background (red circle), with the EIH 1PN relativistic force (force tier = relativistic). The velocity-dependent v^2/c^2 term advances the perihelion each orbit -> a rosette (the Mercury effect, and the same term that gives the weak-field ISCO). Toggle 'force tier' to 'newtonian' in the global inspector to see the orbit close into a fixed ellipse instead.",
  "grid": { "W": 256, "H": 256, "dx": 1.0, "cEff": 1.0, "cfl": 0.7071067811865476 },
  "global": {
    "gEff": 1.0, "kE": 1.0, "shape": "bump", "kernelRadius": 8, "forceInterp": "lewis-birdsall",
    "forceTier": "relativistic",
    "absorber": { "outerBC": "dirichlet", "frictionFloor": 0.0, "frictionWall": 0.02, "frictionDepth": 32, "zeroMeanScalar": false },
    "init": { "method": "none", "settleSteps": 0 },
    "switches": {
      "gravitomagneticForce": false, "gravitomagneticInductive": false,
      "emLorentz": false, "emInductive": false, "emElectrostatic": false, "emMagnetic": false,
      "emStressEnergy": false, "emShapiro": false, "shapiroDynamic": false,
      "fieldEvolution": false, "particleSourceDeposition": false, "esirkepov": false, "periodicBC": false
    },
    "rhoSmooth": 0, "jSmooth": 0, "bgMode": "analytic", "selfFieldDefault": false, "noRadiation": false
  },
  "background": [
    { "x": 128.0, "y": 128.0, "GM": 1.2, "Q": 0.0, "Jz": 0.0, "gFactor": 2.0, "epsilon": 2.0 }
  ],
  "particles": [
    { "x": 163.0, "y": 128.0, "vx": 0.0, "vy": 0.143, "mass": 0.001, "charge": 0.0 }
  ],
  "view": { "field": 0, "showTrails": true, "showVelocity": true, "source": "background", "vectorField": 0, "vectorSpacing": 12, "tickInterval": 0,
    "forceArrows": { "grav": false, "em": false, "spin": false, "total": false } }
}
